{
  "name": "@gnurub/agenda-nest",
  "version": "3.0.0",
  "description": "A lightweight job scheduler for NestJS",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepublish": "node --run build",
    "prepare": "node --run build && husky install",
    "build": "rimraf -rf dist && tsup --config tsup.config.ts && node scripts/write-dist-package-jsons.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings lib --ignore-pattern 'lib/**/*.spec.ts'",
    "test": "node --run lint && node --run test:unit && node --run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project example-smoke",
    "test:coverage": "vitest run --coverage",
    "release": "npx standard-version"
  },
  "authors": [
    {
      "name": "Rubén Cid Lara",
      "email": "rubencidlara@gmail.com"
    },
    {
      "name": "Jonathan Golden",
      "email": "jongolden17@gmail.com"
    }
  ],
  "license": "MIT",
  "url": "https://github.com/gnurub/agenda-nest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnurub/agenda-nest"
  },
  "keywords": [
    "job",
    "jobs",
    "cron",
    "scheduler",
    "runner",
    "agenda",
    "nest",
    "nestjs"
  ],
  "peerDependencies": {
    "@nestjs/common": ">=9.4.3",
    "@nestjs/core": ">=9.4.3",
    "agenda": "^6.2.3",
    "@agendajs/mongo-backend": "^4.0.0",
    "@agendajs/postgres-backend": "^3.0.3",
    "@agendajs/redis-backend": "^3.0.4"
  },
  "peerDependenciesMeta": {
    "@agendajs/mongo-backend": {
      "optional": true
    },
    "@agendajs/postgres-backend": {
      "optional": true
    },
    "@agendajs/redis-backend": {
      "optional": true
    }
  },
  "packageManager": "^bun@1.30.0",
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.0",
    "@agendajs/postgres-backend": "^3.0.3",
    "@agendajs/redis-backend": "^3.0.4",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-angular": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/testing": "^11.1.16",
    "@swc/core": "^1.15.18",
    "@vitest/coverage-v8": "^4.1.0",
    "agenda": "^6.2.3",
    "husky": "^9.1.7",
    "mongodb": "^7.1.0",
    "mongodb-memory-server": "^11.0.1",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.54.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.0"
  }
}