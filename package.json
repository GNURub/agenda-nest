{
  "name": "agenda-nest",
  "version": "3.0.0-rc.0",
  "description": "A lightweight job scheduler for NestJS",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepublish": "npm run build",
    "prepare": "npm run build && husky install",
    "build": "rimraf -rf dist && npm run build:cjs && npm run build:esm && node scripts/write-dist-package-jsons.mjs",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings lib --ignore-pattern 'lib/**/*.spec.ts'",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project example-smoke",
    "test:coverage": "vitest run --coverage",
    "release": "npx standard-version"
  },
  "author": "Jonathan Golden <jongolden17@gmail.com>",
  "license": "MIT",
  "url": "https://github.com/jongolden/agenda-nest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jongolden/agenda-nest"
  },
  "keywords": [
    "job",
    "jobs",
    "cron",
    "scheduler",
    "runner",
    "agenda",
    "nest",
    "nestjs"
  ],
  "peerDependencies": {
    "@nestjs/common": "8.x || 9.x",
    "@nestjs/core": "8.x || 9.x",
    "agenda": "^6.2.3",
    "@agendajs/mongo-backend": "^4.0.0",
    "@agendajs/postgres-backend": "^3.0.3",
    "@agendajs/redis-backend": "^3.0.4"
  },
  "peerDependenciesMeta": {
    "@agendajs/mongo-backend": {
      "optional": true
    },
    "@agendajs/postgres-backend": {
      "optional": true
    },
    "@agendajs/redis-backend": {
      "optional": true
    }
  },
  "packageManager": "^bun@1.30.0",
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.0",
    "@agendajs/postgres-backend": "^3.0.3",
    "@agendajs/redis-backend": "^3.0.4",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-angular": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/testing": "^11.1.16",
    "@swc/core": "^1.15.18",
    "@vitest/coverage-v8": "^4.0.18",
    "agenda": "^6.2.3",
    "husky": "^9.1.7",
    "mongodb": "^7.1.0",
    "mongodb-memory-server": "^11.0.1",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.54.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.18"
  }
}