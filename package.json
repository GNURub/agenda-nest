{
  "name": "@gnurub/agenda-nest",
  "version": "3.2.1",
  "description": "A lightweight job scheduler for NestJS",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "node --run build && node --run test:package",
    "prepare": "node --run build && husky",
    "build": "rimraf -rf dist && tsdown --config tsdown.config.ts && node scripts/write-dist-package-jsons.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings lib --ignore-pattern 'lib/**/*.spec.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --run lint && node --run test:unit && node --run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project example-smoke",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:packed": "node scripts/test-packed-package.mjs",
    "test:ci": "node --run format:check && node --run lint && node --run typecheck && node --run test:unit && node --run test:e2e && node --run test:smoke && node --run test:coverage && node --run build && node --run test:package && node --run test:packed",
    "release": "npx standard-version"
  },
  "authors": [
    {
      "name": "Rubén Cid Lara",
      "email": "rubencidlara@gmail.com"
    },
    {
      "name": "Jonathan Golden",
      "email": "jongolden17@gmail.com"
    }
  ],
  "license": "MIT",
  "url": "https://github.com/gnurub/agenda-nest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnurub/agenda-nest"
  },
  "keywords": [
    "job",
    "jobs",
    "cron",
    "scheduler",
    "runner",
    "agenda",
    "nest",
    "nestjs"
  ],
  "peerDependencies": {
    "@nestjs/common": ">=9.4.3",
    "@nestjs/core": ">=9.4.3",
    "agenda": "^6.2.3",
    "@agendajs/mongo-backend": "^4.0.0",
    "@agendajs/postgres-backend": "^3.0.3",
    "@agendajs/redis-backend": "^3.0.4"
  },
  "peerDependenciesMeta": {
    "@agendajs/mongo-backend": {
      "optional": true
    },
    "@agendajs/postgres-backend": {
      "optional": true
    },
    "@agendajs/redis-backend": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@agendajs/postgres-backend": "^3.0.6",
    "@agendajs/redis-backend": "^3.0.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@vitest/coverage-v8": "^4.1.10",
    "agenda": "^6.2.6",
    "husky": "^9.1.7",
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "^11.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
